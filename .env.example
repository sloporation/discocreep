# Copy to .env and fill in. Read by docker-compose.yml (the watcher, workers,
# API and MariaDB containers). BXT_* vars override any config.yaml values.

# Discord (from the Developer Portal)
BXT_DISCORD_TOKEN=
BXT_DISCORD_CLIENT_ID=
# Optional: dev guild ID for instant per-guild command registration.
# Leave empty to register commands globally.
BXT_DISCORD_GUILD_ID=
# OAuth2 client secret (Developer Portal > OAuth2). Only the web API uses it,
# to log users in with Discord. Keep it secret; never put it in web/.
BXT_DISCORD_CLIENT_SECRET=

# Database. Use "mariadb" when running under docker compose, "localhost" otherwise.
BXT_DB_HOST=mariadb
BXT_DB_PORT=3306
BXT_DB_USER=discordbot
BXT_DB_PASSWORD=change_this_password
BXT_DB_NAME=discordbot
BXT_DB_POOL_SIZE=5

# Redis/Valkey that carries events from the watcher to workers.
# Use "valkey:6379" under docker compose, "localhost:6379" otherwise.
BXT_REDIS_ADDR=valkey:6379
BXT_REDIS_PASSWORD=
BXT_REDIS_DB=0

# How many event partitions guilds are spread across. Caps how many workers
# can share the load. The watcher and all workers must use the same value.
BXT_QUEUE_PARTITIONS=16

# Web API (cmd/api).
# API URL as browsers and Discord reach it. Add <this>/auth/callback as a
# redirect in Developer Portal > OAuth2 > Redirects.
BXT_API_PUBLIC_URL=http://localhost:8080
# The web app's URL: the only origin allowed to call the API, and where users
# land after logging in.
BXT_API_WEB_URL=http://localhost:5173
# Host ports docker compose publishes the API and web app on.
BXT_API_PORT=8080
BXT_WEB_PORT=5173

# Only used by docker compose to initialise the MariaDB container.
BXT_DB_ROOT_PASSWORD=change_this_root_password
