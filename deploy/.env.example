# Settings for deploy/docker-compose.yml. Copy to .env and fill in.
# See the README's Setup section for where each value comes from.

# The release to run (see https://github.com/sloporation/discocreep/releases).
BXT_VERSION=

# Discord (Developer Portal > your application)
BXT_DISCORD_TOKEN=
BXT_DISCORD_CLIENT_ID=
# OAuth2 > Client Secret. Used only by the API, for "Log in with Discord".
BXT_DISCORD_CLIENT_SECRET=
# Optional: a server ID for instant command registration there only.
# Leave empty to register commands globally (can take up to an hour).
BXT_DISCORD_GUILD_ID=

# Public URLs, as users' browsers reach them. Use https (behind your reverse
# proxy). Add <BXT_API_PUBLIC_URL>/auth/callback in Developer Portal >
# OAuth2 > Redirects. Both must be on the same site, e.g. app.example.com and
# api.example.com.
BXT_API_PUBLIC_URL=https://api.example.com
BXT_API_WEB_URL=https://app.example.com
# The header your reverse proxy puts the client's IP in, for per-user rate
# limits: X-Forwarded-For (Caddy, Traefik, nginx), CF-Connecting-IP
# (Cloudflare), X-Real-IP... Leave empty if nothing proxies the API.
BXT_API_CLIENT_IP_HEADER=X-Forwarded-For

# Passwords: set long random values (e.g. `openssl rand -hex 24`).
BXT_DB_PASSWORD=
BXT_DB_ROOT_PASSWORD=
BXT_REDIS_PASSWORD=

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey), so the
# dashboard shows linked Steam accounts' names and avatars.
BXT_STEAM_API_KEY=

# Optional: Battle.net (World of Warcraft) linking. Client from
# https://develop.battle.net/access/clients, redirect URL
# <BXT_API_PUBLIC_URL>/auth/battlenet/callback. Leave empty to turn it off.
BXT_BATTLENET_CLIENT_ID=
BXT_BATTLENET_CLIENT_SECRET=
BXT_BATTLENET_REGIONS=us,eu,kr,tw
BXT_BATTLENET_FLAVOURS=retail,classic,classic_era

# Where the API and web app are published on this machine (your reverse
# proxy forwards to them). 127.0.0.1 = only this machine can reach them.
BXT_BIND_ADDRESS=127.0.0.1
BXT_API_PORT=8080
BXT_WEB_PORT=5173
